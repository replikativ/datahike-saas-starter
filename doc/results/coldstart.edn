;; Cold-start read economics — what a SHORT-LIVED reader (lambda) pays for one query.
;; Env: local MinIO + toxiproxy (bin/latency-proxy 20 => +20ms downstream), GraalVM JDK 25.
;; Stack: datahike 0.8.1735, konserve-s3 0.1.35, konserve 0.9.362.
;; Reproduce:
;;   docker compose --profile tier1 up -d
;;   bin/latency-proxy 20
;;   MINIO_PORT=19000 SAAS_TIER=tier1 clj -M:bench -m datahike-saas.coldstart <bench> <opts>
;;
;; Read this with doc/cost-model.md: request PRICE is a rounding error at $0.40/M GETs.
;; Every number below is about ROUND TRIPS.

{;; ── baseline: cold connect + one open-issues query ────────────────────────
 ;; NOTE `connect` is 1 GET at every size: with :fuse-index-roots? true the index
 ;; roots are inlined in the db record. At 5 issues the query reads NO nodes at all —
 ;; the fused record IS the whole database. The tree only outgrows its root later.
 :cold
 {:latency-ms 0                      ; localhost MinIO, no proxy
  :rows [{:issues 5    :connect {:ms 44.2 :gets 1} :query {:ms 22.3 :gets 0}  :total {:ms 66.5  :gets 1}}
         {:issues 100  :connect {:ms 43.3 :gets 1} :query {:ms 72.5 :gets 6}  :total {:ms 115.9 :gets 7}}
         {:issues 400  :connect {:ms 48.2 :gets 1} :query {:ms 295.6 :gets 20} :total {:ms 343.7 :gets 21}}
         {:issues 1200 :connect {:ms 29.0 :gets 1} :query {:ms 421.5 :gets 57} :total {:ms 450.5 :gets 58}}]}

 ;; ── read amplification: whole store vs what one query touches ─────────────
 ;; Decides whether "preload the whole database" is sane. It is sane exactly when
 ;; total is within a small multiple of the working set — which is what a
 ;; per-tenant database buys you, and what one big shared database does not.
 :shape
 {:latency-ms 20
  :rows [{:issues 5   :objects 8   :query-gets 1  :amplification 8.0}
         {:issues 100 :objects 28  :query-gets 7  :amplification 4.0}
         {:issues 400 :objects 197 :query-gets 21 :amplification 9.4}]}

 ;; ── THE measurement: same key set, increasing concurrency ─────────────────
 ;; Nothing changes about WHAT is fetched — only how many are in flight. The
 ;; spread is pure serialization, and it is recoverable for free.
 ;; konserve-s3 implements neither PMultiReadBackingStore nor
 ;; PMultiWriteBackingStore, so konserve's sync-keys-to-frontend and
 ;; konserve.gc/sweep! both take their serial fallback path today.
 :fanout
 [{:latency-ms 0 :issues 1200 :objects 878
   :list-keys-ms 4636.2               ; konserve list-keys: 1 serial GET per object
   :rows [{:width 1 :ms 4264.7 :per-object-ms 4.86 :speedup 1.0}
          {:width 4 :ms 908.3 :per-object-ms 1.03 :speedup 4.7}
          {:width 16 :ms 726.8 :per-object-ms 0.83 :speedup 5.9}
          {:width 64 :ms 677.1 :per-object-ms 0.77 :speedup 6.3}
          {:width 128 :ms 842.4 :per-object-ms 0.96 :speedup 5.1}]}
  {:latency-ms 20 :issues 400 :objects 197
   :list-keys-ms 6008.7               ; as much as the entire fetch
   :rows [{:width 1 :ms 5843.6 :per-object-ms 29.66 :speedup 1.0}
          {:width 4 :ms 1526.2 :per-object-ms 7.75 :speedup 3.8}
          {:width 16 :ms 468.8 :per-object-ms 2.38 :speedup 12.5}
          {:width 64 :ms 357.0 :per-object-ms 1.81 :speedup 16.4}
          {:width 128 :ms 453.2 :per-object-ms 2.30 :speedup 12.9}]}]

 ;; ── preload everything at connect (tiered {memory, s3}) ───────────────────
 ;; This is NOT a proposal — it is what datahike does TODAY for a :tiered store.
 ;; `ready-store :tiered` (datahike store.cljc) runs konserve's
 ;; populate-missing-strategy on connect, hardcoded, with no strategy option.
 ;; The query afterwards is genuinely free (0 GETs, ~1-3ms). Getting there is not.
 ;; connect-gets ~= 2x objects: perform-sync calls -keys on the backing (list-keys
 ;; = 1 GET/object) and then fetches every key again.
 :preload
 {:latency-ms 20
  :rows [{:issues 100 :naive {:ms 386.3 :gets 7}  :connect {:ms 3179.0 :gets 56}  :query {:ms 3.2 :gets 0}}
         {:issues 400 :naive {:ms 735.8 :gets 21} :connect {:ms 11836.4 :gets 392} :query {:ms 1.0 :gets 0}}]}

 ;; ── budget-bounded BFS warm (prototyped here; now datahike d/warm-db) ─────
 ;; Walks the tree from the ROOT, fetching each level concurrently. Reaches the
 ;; same end state as the full preload above — query at 0 GETs — for 37 fetches
 ;; instead of 392 and 438 ms instead of 11836 ms (27x).
 ;;
 ;; Two reasons it wins, and only one of them is concurrency:
 ;;   - it walks, so it touches only REACHABLE nodes (37, against 40 live and 197
 ;;     total). No -keys enumeration, no garbage. The walk-sync property, obtained
 ;;     by construction rather than by a separate strategy.
 ;;   - it fetches each level in one wave.
 ;; A fixed `perform-sync` (walk-based + parallel) would land near this. The warm's
 ;; durable advantage over that is the BUDGET: it degrades on a store too large to
 ;; hold, instead of refusing to finish.
 ;;
 ;; NOTE :interior fetches 0 here and that is CORRECT — at 100-400 issues the eavt
 ;; tree is height 1, so the interior IS the root, which :fuse-index-roots? already
 ;; delivers with the connect's single GET. These tenants are structurally too small
 ;; to have an interior layer at branching factor 512.
 :warm
 {:latency-ms 20
  :store-cache-size 8192
  :rows [{:issues 100 :depth :interior    :budget 2000
          :connect {:ms 124.2 :gets 1} :warm {:ms 0.9 :gets 0}   :query {:ms 240.1 :gets 6} :total-ms 365.2}
         {:issues 100 :depth :with-leaves :budget 2000
          :connect {:ms 120.0 :gets 1} :warm {:ms 97.9 :gets 9}  :query {:ms 17.6 :gets 0} :total-ms 235.5}
         {:issues 100 :depth :with-leaves :budget 8
          :connect {:ms 111.9 :gets 1} :warm {:ms 87.2 :gets 8}  :query {:ms 57.0 :gets 1} :total-ms 256.1}
         {:issues 400 :depth :interior    :budget 2000
          :connect {:ms 127.3 :gets 1} :warm {:ms 0.1 :gets 0}   :query {:ms 560.8 :gets 20} :total-ms 688.2}
         {:issues 400 :depth :with-leaves :budget 2000
          :connect {:ms 140.9 :gets 1} :warm {:ms 246.3 :gets 37} :query {:ms 50.7 :gets 0} :total-ms 437.9}
         {:issues 400 :depth :with-leaves :budget 8
          :connect {:ms 114.0 :gets 1} :warm {:ms 41.9 :gets 8}  :query {:ms 385.4 :gets 12} :total-ms 541.2}]
  ;; The budget-8 rows are the cliff-freedom claim as a measurement: a partial warm
  ;; gives a partial saving (query 21->12 GETs at 400 issues) and the total lands
  ;; BETWEEN naive and fully-warmed. No step, no mode change, nothing to fall off.
  :no-discontinuity? true}

 ;; ── multi-round BFS on a DEEP tree ────────────────────────────────────────
 ;; The rows above cannot exercise :interior (height 1). Re-seeded at branching
 ;; factor 32 so height 3 is reachable in ~20k datoms instead of ~250k; the walk
 ;; logic is bf-independent, only the interior/total RATIO is not.
 :deep-tree
 {:branching-factor 32 :issues 2500 :height 3
  :rows [{:depth :interior    :fetched 93   :by-level [5 88]      :rounds 2}
         {:depth :with-leaves :fetched 1504 :by-level [5 88 1411] :rounds 3}
         {:depth 1            :fetched 5    :by-level [5]         :rounds 1}]

  ;; :interior stops exactly at the leaf boundary — 93 of 1504 nodes, 2 rounds
  ;; instead of 3 — with no rule enforcing it. Leaves are level 0, so BFS
  ;; terminates there by itself. An integer depth cuts at exactly that many levels.

  ;; CORRECTION to the 1/branching-factor estimate used earlier in this thread.
  ;; Measured interior share is 93/1504 = 6.2%, not 1/32 = 3.1%. The nodes are
  ;; ~50% full (1411 leaves under 88 parents = ~16 children each, not 32), so the
  ;; EFFECTIVE fanout is about half the branching factor and the interior is ~2x
  ;; the naive estimate: interior/total ~= 2/bf, not 1/bf.
  ;;
  ;; At bf 512 that means ~0.4% rather than ~0.2%. For a 95,572-object store the
  ;; interior is ~370 nodes rather than ~190 — still 2 waves at width 256, so the
  ;; conclusion is unchanged, but the arithmetic was optimistic by 2x.
  :effective-fanout ~16
  :interior-share-of-total 0.062}

 ;; ── what a walk-from-the-head would skip ──────────────────────────────────
 ;; Same tenant, preload cost before vs after d/gc-storage. Enumerate-the-bucket
 ;; fetches the garbage too; konserve.tiered/perform-walk-sync (root keys + a
 ;; walk-fn, never calls -keys) would fetch only the live set. No datahike-side
 ;; walk-fn exists to feed it yet.
 :live-only
 {:issues 400 :objects-before-gc 197 :objects-after-gc 40 :garbage 157 :garbage-pct 80.0}}

;; ── Tier 5: the same app on AWS Lambda, locally ───────────────────────────
;; Runtime Interface Emulator + MinIO (bin/lambda-demo). Identical images; the
;; only difference is SAAS_WARM_TENANTS. Tenant: 201 issues, verified by both
;; readers returning the same 201 results from the shared bucket.
;;
;; The three entry points cost wildly different amounts, and only one of them is
;; what people mean by "cold start":
{:tier5-lambda
 {:tenant-issues 201
  :phases
  {:reader-no-warm   {:init   {:ms 238.3  :gets 0  :puts 0}
                      :first  {:ms 3218.1 :gets 18 :puts 2}
                      :warm   {:ms 18.7   :gets 1  :puts 0}}
   :reader-init-warm {:init   {:ms 3495.1 :gets 24 :puts 2}   ; SAAS_WARM_TENANTS=acme
                      :first  {:ms 204.6  :gets 1  :puts 0}   ; 15.7x faster, 18 GETs -> 1
                      :warm   {:ms 14.8   :gets 1  :puts 0}}}

  ;; 1. Warming at INIT moves the work off the request path: first invocation
  ;;    3218ms/18 GETs -> 205ms/1 GET. The remaining GET is the branch-head
  ;;    re-read, which is the Tier-3 tax (bin/reader-gets measures 1.00 GET/deref)
  ;;    showing up on the Lambda path exactly as priced.
  ;;
  ;; 2. WITHOUT SnapStart this is a wash, slightly negative: 238+3218 = 3456ms
  ;;    against 3495+205 = 3700ms, because the warm fetches more (24) than the
  ;;    query needs (18). INIT-warming pays off only when INIT is amortised —
  ;;    i.e. under SnapStart (once per PUBLISHED VERSION, not per container) or
  ;;    with many invocations per container. Do not enable it blind.
  ;;
  ;; 3. JVM INIT is 238ms cold, which is good for Clojure and means SnapStart's
  ;;    value here is mostly the WARM STATE, not the JVM boot.
  ;;
  ;; 4. Steady-state writes through the writer function: 1-2 PUTs at 50-70ms,
  ;;    confirming the 1.00 PUT/commit claim on the Lambda path. A tenant's FIRST
  ;;    write is ~16 PUTs (create-database + schema + migrations), not steady state.
  ;;
  ;; OPEN BUG: the reader reports 2 PUTs on first tenant open. A read replica must
  ;; not write; likely ensure-schema!/migrations running in the reader's pool.
  :open-bug "reader performs 2 PUTs on first tenant open"}}

;; ── pg-datahike: an UNMODIFIED psycopg app over object storage ────────────
;; docker compose --profile tier5-pg up -d minio pg-server
;; docker compose --profile tier5-pg run --rm pybench
;;
;; A tenant IS a PG database name — postgresql://pg-server:5432/acme routes to
;; that tenant's conn (pg/start-server takes a {name -> conn} registry). So
;; db-per-tenant needs no WHERE tenant_id and no schema-per-tenant trick, and the
;; client is a stock psycopg app that knows none of it.
;;
;; This is the COMPONENT measurement under the Lambda-extension shape (Python
;; handler + JVM extension sharing localhost). It is not a Lambda emulation —
;; though RIE does proxy the Extensions API, so the full packaging is simulable.
{:tier5-pg
 {:boot {:total-ms 1736 :tenant-open-ms 1505}   ; JVM + pool + tenant + wire bind
  :client
  {:connect+first-roundtrip-ms 516.84
   :insert     {:n 50 :p50-ms 46.44 :p95-ms 73.47}   ; = the S3 commit (1 PUT) + translation
   :count-star {:first-ms 66.48}
   :select-pk  {:n 50 :p50-ms 6.92 :p95-ms 9.04}
   :select-scan-limit-20 {:p50-ms 2.87}}

  ;; 1. WARM SQL is single-digit ms through the whole stack: psycopg -> wire
  ;;    protocol -> SQL translation -> datahike -> warm node cache. Usable.
  ;; 2. INSERT at 46ms p50 matches the writer Lambda's measured 50-70ms for the
  ;;    same commit, so the SQL path adds little over the native one.
  ;; 3. Boot is 1.7s, of which 1.5s is opening the tenant — NOT the JVM (238ms
  ;;    measured separately). That is the number SnapStart would amortise, and the
  ;;    one the warm work targets.
  ;; 4. Scans beat point lookups (2.87 vs 6.92) — same warm nodes, less
  ;;    translation per row.
  ;;
  ;; Supports the session argument: ~2s once when a user starts interacting, then
  ;; single-digit ms while they do. Bad as an API SLA, fine for a niche app.
  }}

;; ── Tier 5 polyglot: Python handler + JVM extension, ONE Lambda env ───────
;; Verified end-to-end against RIE + MinIO. An unmodified psycopg handler talking
;; SQL to Datahike over object storage; pg-datahike runs as an EXTERNAL EXTENSION
;; in the same execution environment, so 127.0.0.1:5432 is a JVM, not a Postgres.
{:tier5-polyglot
 {:extension-init {:pool-ms 51 :open-ms 3070 :warm-ms 0 :bind-ms 4190 :total-ms 7311}
  :handler {:lazy-connect-ms 265 :first-read-ms 396.75
            :write-20-notes-ms 2349.94    ; 20x (DELETE + INSERT), ~59ms/statement
            :warm-read-ms 8.52}

  ;; 1. The connection MUST be lazy. Function init has a hard ~10s budget, and
  ;;    Extension init runs CONCURRENTLY with Runtime init -- Lambda waits for both
  ;;    to signal Next but does not hold the runtime while an extension boots. A
  ;;    module-level connect therefore both races the JVM and then blocks init
  ;;    waiting for it, against a 7.3s extension boot. This killed every earlier
  ;;    run. It is an AWS requirement, not a local artefact.
  ;;
  ;; 2. RIE is FAITHFUL here, contrary to an earlier note in this file's history:
  ;;    it enables extensions by default (rie/run.go SetExtensionsFlag(true)) and
  ;;    runs doInitExtensions before doRuntimeBootstrap (rapid/handlers.go). It
  ;;    embeds the same `rapid` orchestrator. What it does NOT do is forward agent
  ;;    stdout -- so probe the socket for readiness, never `docker logs | grep`.
  ;;
  ;; 3. bind=4190ms is the largest single term and is UNEXAMINED. Binding a socket
  ;;    is microseconds; this is pg-datahike building its SQL translator and pg_*
  ;;    catalogs. Likely both lazy-able and the most SnapStart-amortisable part.
  ;;
  ;; 4. UPSTREAM BUG found here: `INSERT ... ON CONFLICT` with PARAMETERS fails --
  ;;    "class datahike.pg.sql.params.ParamRef cannot be cast to java.lang.Number".
  ;;    Isolated: plain INSERT + params OK; ON CONFLICT + literals OK; ON CONFLICT
  ;;    + params FAILS. The example uses DELETE + plain INSERT until it is fixed.
  ;;    Matters because every ORM emits parameterised upserts.
  :open "bind=4190ms unprofiled; pg-datahike ON CONFLICT + params bug"}}

;; ── CORRECTION to :tier5-polyglot's bind=4190ms ───────────────────────────
;; Measured directly: pg/start-server takes 23ms on a cold JVM and 1ms on repeat
;; calls in the same process. So the 4190ms was NOT the server starting -- it was
;; `requiring-resolve` loading the pg-datahike namespace tree, timed inside the
;; same block. The instrumentation now splits load= from bind=.
;;
;; This changes the fix. Class loading is not lazy-able (you need the code to
;; serve SQL) but it is exactly what a heap snapshot removes:
;;   - SnapStart / native-image: the right levers
;;   - restructuring pg-datahike: NOT the lever; there is no eager catalog build
;;   - Cloud Run: also fine, since a long-lived container pays it once
;; And it explains why the Clojure-only Lambda path is 238ms: no pg-datahike load.
{:tier5-polyglot-correction
 {:start-server-ms {:cold 23 :warm 1}
  :was-mislabelled "bind=4190ms was namespace/class loading, not socket bind"}}
